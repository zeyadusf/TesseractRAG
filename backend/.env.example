# ═══════════════════════════════════════════════════════════════
# TesseractRAG – Environment Configuration
# Priority: System Env Vars > .env file > config.py defaults
# ═══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
APP_NAME=TesseractRAG
DEBUG=false

# ── API Keys ───────────────────────────────────────────────────
# Set HF_API_TOKEN via system env for security:
# Windows: setx HF_API_TOKEN "hf_xxxxxxxx"  → then restart terminal
HF_API_TOKEN=
COHERE_API_KEY=

# ── Models ─────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL_1=meta-llama/Llama-3.1-8B-Instruct

# ── Chunking & Retrieval ───────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
FINAL_TOP_K=3
DIM_EMBEDDING=384
MAX_CONTEXT_CHARS=3000

# ── Cloudflare R2 / S3-Compatible Storage ──────────────────────
# Endpoint examples:
#   Cloudflare R2: https://{account_id}.r2.cloudflarestorage.com
#   Backblaze B2:  https://s3.{region}.backblazeb2.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── 🔌 NEW: Backend Selection (Pluggable Storage & Vector) ─────
# Options for METADATA_BACKEND: "s3" | "postgresql"
# Options for VECTOR_STORE_BACKEND: "faiss" | "pgvector"
# Default = keep current behavior (S3 + FAISS)
METADATA_BACKEND=s3
VECTOR_STORE_BACKEND=faiss

# ── PostgreSQL Connection (used when BACKEND=postgresql) ───────
# Format: postgresql+asyncpg://user:pass@host:port/dbname
# Example local: postgresql+asyncpg://postgres:postgres@localhost:5432/tessrag
# Example Docker: postgresql+asyncpg://postgres:postgres@db:5432/tessrag
DATABASE_URL=

# ── FAISS Local Path (used when VECTOR_STORE_BACKEND=faiss) ────
FAISS_INDEX_DIR=./data/sessions

# ── Paths ──────────────────────────────────────────────────────
DATA_DIR=./data